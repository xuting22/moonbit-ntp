import {
  "localreview/ntp" @lib,
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "query_request",
        "query_response",
        "query_response_at",
        "protocol",
      ],
      "format": "esm",
    },
  },
)
